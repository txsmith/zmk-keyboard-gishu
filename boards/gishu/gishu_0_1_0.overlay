/ {
    chosen {
        zmk,battery = &vbatt;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };
};

&spi3_default {
    group1 {
        psels = <NRF_PSEL(SPIM_MOSI, 1, 10)>;
    };
};

&spi3_sleep {
    group1 {
        psels = <NRF_PSEL(SPIM_MOSI, 1, 10)>;
        low-power-enable;
    };
};

&i2c0 {
    status = "disabled";
};

&fuelgauge {
    status = "disabled";
};
