if BOARD_GISHU

config ZMK_KEYBOARD_NAME
    default "Gishu"


if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB


config BT_CTLR
    default BT

config ZMK_BLE
    default y

config ZMK_USB
    default y

config ZMK_INDICATOR_LED_STRIP
    default y
    select SPI
    select LED_STRIP
    select WS2812_STRIP

endif # BOARD_GISHU
